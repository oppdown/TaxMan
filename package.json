{
  "name": "taxman",
  "version": "0.2.5",
  "description": "Local income and expenditure ledger for tax preparation",
  "main": "src/main.cjs",
  "author": "TaxMan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.cjs test/menu.test.cjs",
    "test:ui": "electron test/ui-smoke.cjs",
    "test:restore": "electron test/restore-integration.cjs",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.localtaxledger.ledger2025",
    "productName": "TaxMan",
    "asar": true,
    "files": [
      "src/**/*",
    "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/taxman-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "TaxMan-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TaxMan-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "TaxMan-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  }
}
