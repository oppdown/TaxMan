{
  "name": "taxman",
  "version": "0.4.4",
  "description": "Local income and expenditure ledger for tax preparation",
  "main": "src/main.cjs",
  "author": "TaxMan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.cjs test/menu.test.cjs test/store-file.test.cjs test/ocr.test.cjs",
    "test:ui": "electron test/ui-smoke.cjs",
    "test:phone-capture": "electron test/phone-capture-integration.cjs",
    "test:pairing": "electron test/pairing-integration.cjs",
    "build:mobile": "node scripts/prepare-mobile-build.cjs",
    "test:mobile": "npm run build:mobile && electron test/mobile-web-smoke.cjs",
    "test:restore": "electron test/restore-integration.cjs",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.localtaxledger.ledger2025",
    "productName": "TaxMan",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/taxman-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TaxMan-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TaxMan-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "TaxMan-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oppdown",
        "repo": "TaxMan",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  }
}
